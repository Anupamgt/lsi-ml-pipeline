# LSI ML Pipeline — .gitignore

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/

# ─── Jupyter ──────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ─── Pipeline outputs ─────────────────────────────────────────────────────────
# Ephemeral local runs (regenerate anytime)
outputs*/
outputs_real/

# Phase 0 VLM docs/stats under outputs_vlm/ (GeoTIFFs stay ignored via *.tif)
!outputs_vlm/
!outputs_vlm/**/
!outputs_vlm/**/*.md
!outputs_vlm/**/*.json


# Curated committed results (metrics, plots, classified maps) — allow results/
# but still ignore heavy pickles inside results/
!results/
!results/**

# ─── QGIS / GIS files outside final_maps/ ─────────────────────────────────────
# Ignore raw uncompressed rasters outside our compressed final_maps directory
*.tif
*.tiff
*.vrt
*.qgz
*.qgs
*.gpkg
*.shp
*.shx
*.dbf
*.prj
*.sbn
*.sbx
*.cpg
*.kml
*.kmz

# Explicitly un-ignore our curated, compressed final maps and datasets!
!final_maps/
!final_maps/**
!data/
!data/**

# ─── Pickle / binary model files ─────────────────────────────────────────────
*.pkl
*.joblib
# Keep ignoring pickles even under results/ (regenerate via run_pipeline.py)
results/**/*.pkl
results/**/*.joblib

# ─── Secrets (never commit) ──────────────────────────────────────────────────
.env
.env.*

# ─── OS / editor ─────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ─── pytest cache ────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
