# LSI ML Pipeline — .gitignore

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/

# ─── Jupyter ──────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ─── Pipeline outputs ─────────────────────────────────────────────────────────
# Trained models and scalers (binary, large)
outputs*/
outputs_real/

# ─── QGIS / GIS files outside final_maps/ ─────────────────────────────────────
# Ignore raw uncompressed rasters outside our compressed final_maps directory
*.tif
*.tiff
*.vrt
*.qgz
*.qgs
*.gpkg
*.shp
*.shx
*.dbf
*.prj
*.sbn
*.sbx
*.cpg
*.kml
*.kmz

# Explicitly un-ignore our curated, compressed final maps and datasets!
!final_maps/*
!data/*

# ─── Pickle / binary model files ─────────────────────────────────────────────
*.pkl
*.joblib

# ─── OS / editor ─────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ─── pytest cache ────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
